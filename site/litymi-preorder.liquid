{id:'pants',img:'l3-pants',fit:62,bottom:1,price:95,name:'Wide-Leg Pants',short:'PANTS',handle:'wide-leg-pants-1',w:{front:555,back:544},h:{front:817,back:819},desc:'Grey baggy wide-leg pants with curved panel seams, a leopard print boxer waistband, a drawstring, a back pocket and the crown and star on the leg.'},
{id:'czip',img:'l3-zip',fit:86,top:1,pair:'shorts',set:'ZIP SET',price:119,name:'Cropped Zip Hoodie',short:'CROPPED HOODIE',handle:'cropped-zip-hoodie-2',w:{front:700,back:700},h:{front:668,back:648},desc:'Light grey cropped zip hoodie with a leopard print lined hood, a boxy fit, the crown and star on the chest and the puff LITYMI logo on the back.'},
{id:'shorts',img:'l3-shorts',fit:76,bottom:1,price:85,name:'Shorts',short:'SHORTS',handle:'shorts-2',w:{front:585,back:585},h:{front:560,back:556},desc:'Light grey knee-length shorts with a leopard print boxer waistband, a drawstring, a back pocket and the crown and star on the leg.'}];
var TOPS=ITEMS.filter(function(i){return i.top;});
var MSG={};
var S={view:'front',card:{}};
ITEMS.forEach(function(i){S.card[i.id]={side:'front',size:'M'};});
S.card.mix={side:'front',top:TOPS[0].id,bottom:TOPS[0].pair,ts:'M',bs:'M'};
var KEYS=Object.keys(S.card);
var $=function(id){return document.getElementById(id);};
function pill(label,on,attrs,extra){return '<button type="button" class="pill'+(extra||'')+'" aria-pressed="'+on+'" '+attrs+'>'+label+'</button>';}
var CH='<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="%P" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
function arrows(id,side){return '<button type="button" class="arrow l" aria-label="Show front view" data-act="side" data-id="'+id+'" data-v="front"'+(side==='front'?' disabled':'')+'>'+CH.replace('%P','M11 3 L5 9 L11 15')+'</button>'
 +'<button type="button" class="arrow r" aria-label="Show back view" data-act="side" data-id="'+id+'" data-v="back"'+(side==='back'?' disabled':'')+'>'+CH.replace('%P','M7 3 L13 9 L7 15')+'</button><div class="vl">'+side.toUpperCase()+'</div>';}
function sizes(id,key,cur){return '<div class="pills">'+SIZES.map(function(s){return pill(s,cur===s,'data-act="size" data-id="'+id+'" data-k="'+key+'" data-v="'+s+'"');}).join('')+'</div>';}
function chooseSet(cur){return '<div class="pills">'+TOPS.map(function(i){return pill(i.set,cur===i.id,'data-act="pick" data-v="'+i.id+'"',' w');}).join('')+'</div>';}
function renderTop(){
 var all=KEYS.every(function(k){return S.card[k].side===S.view;});
 $('g-view').innerHTML=['front','back'].map(function(v){return pill(v.toUpperCase(),all&&S.view===v,'data-act="allview" data-v="'+v+'"',' big');}).join('');
}
function mixCard(){var st=S.card.mix,sd=st.side,tp=item(st.top),bt=item(st.bottom),full=tp.price+bt.price,sp=Math.round(full*90)/100;
 var tw=tp.w[sd],th=tp.h[sd],bw=bt.w[sd],bh=bt.h[sd],ov=Math.round(th*0.05),W=Math.max(tw,bw),H=th+bh-ov;
 return '<div class="card mix" id="c-mix"><div class="media"><div class="tag">FULL SET &middot; SAVE 10%</div>'
  +'<div class="stk" style="aspect-ratio:'+W+'/'+H+'">'
  +'<img class="tp" src="'+img(tp.img+'-'+sd)+'" alt="'+tp.name+', '+sd+' view" width="'+tw+'" height="'+th+'" style="width:'+(tw/W*100).toFixed(2)+'%">'
  +'<img src="'+img(bt.img+'-'+sd)+'" alt="'+bt.name+', '+sd+' view" width="'+bw+'" height="'+bh+'" style="width:'+(bw/W*100).toFixed(2)+'%;margin-top:-'+(ov/W*100).toFixed(2)+'%">'
  +'</div>'+arrows('mix',sd)+'</div>'
  +'<div class="body"><div><div class="row1"><div class="pname">Build your set</div><div class="price"><s>A$'+full+'</s>A$'+sp.toFixed(2)+'</div></div><span class="save">YOU SAVE A$'+(full-sp).toFixed(2)+'</span></div>'
  +'<div class="desc">Pick a set to see the hoodie and bottoms together: the '+tp.name+' with the '+bt.name+'. Choose a size for each piece. 10% off is applied automatically at checkout.</div>'
  +'<div class="opt"><div class="optl">SET</div>'+chooseSet(st.top)+'</div>'
  +'<div class="opt"><div class="optl">'+tp.short+' SIZE</div>'+sizes('mix','ts',st.ts)+'</div>'
  +'<div class="opt"><div class="optl">'+bt.short+' SIZE</div>'+sizes('mix','bs',st.bs)+'</div>'
  +'<div class="cta"><button type="button" class="btn dark" data-act="addmix">ADD THE SET TO PREORDER</button><div class="msg" aria-live="polite">'+(MSG.mix||'')+'</div></div></div></div>';}
function itemCard(it){var c=S.card[it.id];
  return '<div class="card" id="c-'+it.id+'"><div class="media"><div class="tag">PREORDER</div>'
  +'<img src="'+img(it.img+'-'+c.side)+'" alt="'+it.name+', '+c.side+' view" width="'+it.w[c.side]+'" height="'+it.h[c.side]+'" style="width:'+it.fit+'%">'+arrows(it.id,c.side)+'</div>'
  +'<div class="body"><div><div class="row1"><div class="pname">'+it.name+'</div><div class="price">A$'+it.price+'</div></div><div class="desc">'+it.desc+'</div></div>'
  +'<div class="opt"><div class="optl">SIZE</div>'+sizes(it.id,'size',c.size)+'</div>'
  +'<div class="cta"><button type="button" class="btn dark" data-act="add" data-id="'+it.id+'">ADD TO PREORDER</button><div class="msg" aria-live="polite">'+(MSG[it.id]||'')+'</div></div></div></div>';}
function cardHTML(k){return k==='mix'?mixCard():itemCard(item(k));}
function renderCard(k){var el=$('c-'+k);if(!el){renderGrid();return;}var w=document.createElement('div');w.innerHTML=cardHTML(k);el.replaceWith(w.firstChild);}
function renderGrid(){
 $('grid').innerHTML=mixCard()+ITEMS.map(itemCard).join('');
}
var money=function(c){return 'A$'+(c/100).toFixed(2);};
var hx=function(x){return String(x).replace(/[&<>"]/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m];});};
function api(u,o){return fetch(u,o).then(function(r){return r.json().then(function(d){if(!r.ok)throw new Error(d.description||d.message||'Error');return d;});});}
var CART=null,PROD={};
function loadCart(){return api('/cart.js').then(function(c){CART=c;renderCart();return c;});}
function openBag(){$('dr').classList.add('on');$('ov').classList.add('on');$('dr').setAttribute('aria-hidden','false');document.body.style.overflow='hidden';}
function closeBag(){$('dr').classList.remove('on');$('ov').classList.remove('on');$('dr').setAttribute('aria-hidden','true');document.body.style.overflow='';}
function renderCart(){
 var c=CART||{items:[],item_count:0};$('bagN').textContent=c.item_count;
 if(!c.items.length){$('drb').innerHTML='<div class="empty">Your bag is empty.</div>';$('drf').innerHTML='<a class="btn" href="#shop" data-act="closebag">KEEP SHOPPING</a>';return;}
 $('drb').innerHTML=c.items.map(function(i){var im=i.featured_image&&i.featured_image.url?'<img src="'+hx(i.featured_image.url)+'" alt="">':'';
  var price=i.original_line_price!==i.final_line_price?'<s>'+money(i.original_line_price)+'</s>'+money(i.final_line_price):money(i.final_line_price);
  return '<div class="li">'+im+'<div style="flex:1;min-width:0"><div class="t">'+hx(i.product_title)+'</div><div class="v">Size '+hx(i.variant_title||'')+'</div><div class="r"><div class="q"><button type="button" aria-label="Fewer" data-act="qty" data-key="'+hx(i.key)+'" data-q="'+(i.quantity-1)+'">&minus;</button><span>'+i.quantity+'</span><button type="button" aria-label="More" data-act="qty" data-key="'+hx(i.key)+'" data-q="'+(i.quantity+1)+'">+</button></div><div>'+price+'</div></div></div></div>';}).join('');
 var n=c.item_count,tip=n===1?'Add 1 more piece to save 10%':n===2?'10% off applied. Add 1 more piece for 15% off.':'15% off applied.';
 var disc=c.total_discount>0?'<div class="row"><span>Discount</span><span>&minus;'+money(c.total_discount)+'</span></div>':'';
 $('drf').innerHTML='<div class="tip">'+tip+'</div><div class="row"><span>Subtotal</span><span>'+money(c.original_total_price)+'</span></div>'+disc+'<div class="row tot"><span>Total</span><span>'+money(c.total_price)+'</span></div><div style="font-size:15px;color:#6B5A44;text-align:center">Shipping calculated at checkout. Free over A$150.</div><a class="btn" href="/checkout">CHECKOUT</a>';
}
function item(id){return ITEMS.filter(function(i){return i.id===id;})[0];}
function variant(id,size){var it=item(id);
 var p=PROD[id]?Promise.resolve(PROD[id]):api('/products/'+it.handle+'.js').then(function(d){PROD[id]=d;return d;});
 return p.then(function(d){var v=d.variants.filter(function(x){return x.title===size;})[0];if(!v)throw new Error('missing');return v.id;});}
function setMsg(id,t){MSG[id]=t;var m=document.querySelector('#c-'+id+' .msg');if(m)m.textContent=t;else renderCard(id);}
var BUSY={};
function addLines(key,lines){
 if(BUSY[key])return;BUSY[key]=1;
 setMsg(key,'Adding...');
 Promise.all(lines.map(function(l){return variant(l[0],l[1]);}))
 .then(function(ids){return api('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:ids.map(function(v){return {id:v,quantity:1};})})});})
 .then(loadCart).then(function(){setMsg(key,'Added to your bag');openBag();setTimeout(function(){if(MSG[key]==='Added to your bag')setMsg(key,'');},2500);})
 .catch(function(){setMsg(key,'Could not add this. Please try again.');}).then(function(){BUSY[key]=0;});
}
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeBag();});
document.querySelector('.lt').addEventListener('click',function(e){
 var b=e.target.closest('[data-act]');if(!b)return;var a=b.getAttribute('data-act'),v=b.getAttribute('data-v'),id=b.getAttribute('data-id');
 if(a==='openbag'){openBag();return;}
 if(a==='closebag'){closeBag();return;}
 if(a==='add'){addLines(id,[[id,S.card[id].size]]);return;}
 if(a==='addmix'){var m=S.card.mix;addLines('mix',[[m.top,m.ts],[m.bottom,m.bs]]);return;}
 if(a==='pick'){S.card.mix.top=v;S.card.mix.bottom=item(v).pair;renderCard('mix');return;}
 if(a==='qty'){if(b.disabled)return;b.disabled=true;api('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:b.getAttribute('data-key'),quantity:parseInt(b.getAttribute('data-q'),10)})}).then(function(c){CART=c;renderCart();}).catch(function(){b.disabled=false;});return;}
 if(a==='allview'){S.view=v;KEYS.forEach(function(k){S.card[k].side=v;});renderTop();renderGrid();return;}
 if(a==='side')S.card[id].side=v;
 else if(a==='size')S.card[id][b.getAttribute('data-k')]=v;
 else return;
 renderCard(id);renderTop();
});
renderTop();renderGrid();loadCart().catch(function(){});
setTimeout(function(){ITEMS.forEach(function(i){['front','back'].forEach(function(s){(new Image()).src=img(i.img+'-'+s);});variant(i.id,'M').catch(function(){});});},800);
})();
</script>

